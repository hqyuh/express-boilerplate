{
  "name": "express-boilerplate",
  "version": "1.0.0",
  "description": "",
  "main": "/src/server.js",
  "scripts": {
    "build": "rm -rf dist && mkdir dist && tsc --project tsconfig.build.json",
    "start:prod": "node -r module-alias/register dist/server.js",
    "start:dev": "nodemon -e ts,js --exec ts-node -r tsconfig-paths/register src/server.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write --unsafe .",
    "check": "biome check .",
    "fix": "biome check --write --unsafe .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-http-context": "^2.0.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "module-alias": "^2.3.4",
    "moment": "^2.31.0",
    "multer": "2.4.0",
    "nodemon": "^3.1.14",
    "object-hash": "^3.0.0",
    "pg": "^8.23.1",
    "rate-limit-redis": "^6.0.1",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "typeorm": "^1.1.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.26",
    "@types/module-alias": "^2.0.4",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/object-hash": "^3.0.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "supertest": "^7.3.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "_moduleAliases": {
    "@": "dist"
  },
  "packageManager": "pnpm@11.0.9"
}
