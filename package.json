{
  "name": "express-boilerplate",
  "version": "1.0.0",
  "description": "",
  "main": "/src/server.js",
  "scripts": {
    "build": "rm -rf dist && mkdir dist && tsc --project tsconfig.build.json",
    "start:prod": "node -r module-alias/register dist/server.js",
    "start:dev": "nodemon -e ts,js --exec ts-node -r tsconfig-paths/register src/server.ts",
    "format": "prettier --config .prettierrc --check --ignore-unknown \"src/**/*.ts\"",
    "format:fix": "prettier --config .prettierrc --write --ignore-unknown \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "fix": "concurrently \"npm:format:fix\" \"npm:lint:fix\"",
    "test": "jest src/__tests__/routes --forceExit",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-http-context": "^2.0.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "module-alias": "^2.3.4",
    "moment": "^2.30.1",
    "multer": "2.2.0",
    "nodemon": "^3.1.14",
    "object-hash": "^3.0.0",
    "pg": "^8.22.0",
    "rate-limit-redis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "typeorm": "^1.1.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.21.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/module-alias": "^2.0.4",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/object-hash": "^3.0.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-helpers": "^2.0.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "_moduleAliases": {
    "@": "dist"
  },
  "pnpm": {
    "overrides": {
      "@types/express": "^5.0.6"
    },
    "onlyBuiltDependencies": [
      "@scarf/scarf",
      "unrs-resolver"
    ]
  }
}
