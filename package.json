{
  "name": "express-boilerplate",
  "version": "1.0.0",
  "description": "",
  "main": "/src/server.js",
  "scripts": {
    "build": "rm -rf dist && mkdir dist && tsc --project tsconfig.build.json",
    "start:prod": "node -r module-alias/register dist/server.js",
    "start:dev": "nodemon -e ts,js --exec ts-node -r tsconfig-paths/register src/server.ts",
    "format": "prettier --config .prettierrc --check --ignore-unknown \"src/**/*.ts\"",
    "format:fix": "prettier --config .prettierrc --write --ignore-unknown \"src/**/*.ts\"",
    "lint": "eslint --ext .ts \"src/**/*.ts\"",
    "lint:fix": "eslint --ext .ts --fix \"src/**/*.ts\"",
    "fix": "concurrently \"npm:format:fix\" \"npm:lint:fix\"",
    "test": "jest src/__tests__/routes",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-http-context": "^1.2.4",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "module-alias": "^2.2.3",
    "moment": "^2.30.1",
    "multer": "1.4.5-lts.1",
    "nodemon": "^3.1.9",
    "object-hash": "^3.0.0",
    "pg": "^8.13.1",
    "rate-limit-redis": "^4.2.0",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.20",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.15",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/lodash": "^4.17.15",
    "@types/module-alias": "^2.0.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.1",
    "@types/object-hash": "^3.0.6",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "concurrently": "^9.1.2",
    "eslint": "8.56.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-import-helpers": "^2.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-sonarjs": "^1.0.3",
    "eslint-plugin-unicorn": "^56.0.1",
    "husky": "^9.1.7",
