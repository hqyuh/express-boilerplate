# Env file for production environment
HOST=server
PORT=4000
CONTEXT_PATH=/api/v1
NODE_ENV=production
DB_HOST=database
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=express-database
DB_TYPE=postgres
DB_PORT=5432
ACCESS_TOKEN_SECRET_KEY='your_access_secret_key'
ACCESS_TOKEN_EXPIRES_IN='1d'
REFRESH_TOKEN_SECRET_KEY='your_refresh_secret_key'
REFRESH_TOKEN_EXPIRES_IN='7d'

# redis config
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=redis
REDIS_PREFIX=express_boilerplate_

DOCKER_CONTAINER=true
REDIS_HOST_DOCKER=redis # redis container name